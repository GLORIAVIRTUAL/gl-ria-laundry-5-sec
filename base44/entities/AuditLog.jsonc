{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "view",
        "update",
        "delete",
        "approve",
        "reject",
        "export",
        "login",
        "logout",
        "upload",
        "download",
        "reconcile",
        "refund",
        "status_change",
        "permission_change",
        "ai_review"
      ],
      "default": "delete",
      "description": "Ação de negócio ou segurança registrada"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "payment",
        "finance_entry",
        "order",
        "quote",
        "garment_item",
        "purchase_document",
        "stock_item",
        "stock_movement",
        "supplier",
        "accounts_payable",
        "accounts_receivable",
        "cash_session",
        "cash_movement",
        "financial_document",
        "third_party_job",
        "rework",
        "quality_check",
        "document_asset",
        "ai_job",
        "human_review",
        "user",
        "unit",
        "integration"
      ],
      "description": "Tipo do registro afetado"
    },
    "entity_id": {
      "type": "string",
      "description": "ID do registro afetado"
    },
    "item_label": {
      "type": "string",
      "description": "Identificação legível do registro"
    },
    "customer_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "description": "Justificativa humana ou técnica da ação"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "description": "Identificador de correlação da requisição"
    },
    "session_id": {
      "type": "string"
    },
    "ip_hash": {
      "type": "string",
      "description": "Hash opcional do IP, evitando registrar o endereço bruto"
    },
    "before_data": {
      "type": "object",
      "additionalProperties": true
    },
    "after_data": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "success": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "entity_type",
    "reason"
  ]
}
