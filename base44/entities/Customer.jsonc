{
  "name": "Customer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es"
      ],
      "default": "pt"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "zip_code": {
      "type": "string",
      "description": "CEP"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opt_in_whatsapp": {
      "type": "boolean",
      "default": false
    },
    "opt_in_whatsapp_at": {
      "type": "string",
      "format": "date-time"
    },
    "opt_out_whatsapp_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_consent_status": {
      "type": "string",
      "enum": [
        "unknown",
        "pending",
        "accepted",
        "revoked"
      ],
      "default": "unknown"
    },
    "whatsapp_consent_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_consent_request_text": {
      "type": "string"
    },
    "whatsapp_consent_response_text": {
      "type": "string"
    },
    "whatsapp_consent_source": {
      "type": "string"
    },
    "opt_in_email": {
      "type": "boolean",
      "default": false
    },
    "last_inbound_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_outbound_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "vip"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "address_number": {
      "type": "string"
    },
    "address_complement": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "ID da unidade preferida do cliente"
    },
    "preferred_unit_name": {
      "type": "string",
      "description": "Nome da unidade preferida do cliente"
    }
  },
  "required": [
    "full_name"
  ]
}