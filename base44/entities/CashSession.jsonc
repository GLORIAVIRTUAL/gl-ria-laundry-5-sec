{
  "name": "CashSession",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "operator_user_id": { "type": "string" },
    "operator_name": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "counting", "pending_approval", "closed", "cancelled"], "default": "open" },
    "opened_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "opening_amount": { "type": "number", "default": 0 },
    "expected_cash_amount": { "type": "number", "default": 0 },
    "counted_cash_amount": { "type": "number" },
    "difference_amount": { "type": "number" },
    "income_amount": { "type": "number", "default": 0 },
    "supply_amount": { "type": "number", "default": 0 },
    "withdrawal_amount": { "type": "number", "default": 0 },
    "refund_amount": { "type": "number", "default": 0 },
    "approved_by_user_id": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "difference_reason": { "type": "string" },
    "notes": { "type": "string" },
    "request_id": { "type": "string" }
  },
  "required": ["unit_id", "operator_user_id", "status", "opened_at"]
}
