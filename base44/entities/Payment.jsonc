{
  "name": "Payment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "ID da unidade respons\u00e1vel pelo pagamento"
    },
    "stripe_intent_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "expired"
      ],
      "default": "pending"
    },
    "amount": {
      "type": "number"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit",
        "debit",
        "pix",
        "cash",
        "link"
      ],
      "default": "link"
    },
    "installments": {
      "type": "number",
      "description": "N\u00famero de parcelas (apenas para cr\u00e9dito na maquininha)"
    },
    "card_brand": {
      "type": "string",
      "description": "Bandeira do cart\u00e3o usada na maquininha (ex: Visa, Mastercard)"
    },
    "fee_percent": {
      "type": "number",
      "description": "Percentual de taxa aplicado pela maquininha nesta venda"
    },
    "fee_amount": {
      "type": "number",
      "description": "Valor descontado em reais referente \u00e0 taxa da maquininha"
    },
    "notes": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da forma de pagamento (ex: Maquininha - Cr\u00e9dito 3x)"
    }
  },
  "required": [
    "customer_id",
    "amount"
  ]
}