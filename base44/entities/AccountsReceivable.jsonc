{
  "name": "AccountsReceivable",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "order_id": { "type": "string" },
    "quote_id": { "type": "string" },
    "description": { "type": "string" },
    "issue_date": { "type": "string", "format": "date-time" },
    "due_date": { "type": "string", "format": "date-time" },
    "original_amount": { "type": "number" },
    "discount_amount": { "type": "number", "default": 0 },
    "interest_amount": { "type": "number", "default": 0 },
    "paid_amount": { "type": "number", "default": 0 },
    "open_amount": { "type": "number" },
    "status": {
      "type": "string",
      "enum": ["draft", "open", "partially_paid", "paid", "overdue", "cancelled", "written_off"],
      "default": "open"
    },
    "billing_type": { "type": "string", "enum": ["immediate", "invoiced", "customer_balance", "courtesy"], "default": "immediate" },
    "payment_allocation_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "collection_status": { "type": "string", "enum": ["not_started", "reminded", "negotiating", "promised", "disputed"], "default": "not_started" },
    "notes": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "required": ["unit_id", "customer_id", "description", "due_date", "original_amount", "open_amount", "status"]
}
